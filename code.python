import serial
import numpy as np
import pywt
import zlib
import time
import json
from scipy.signal import butter, filtfilt
import binascii

# --- Konfigurasi Serial ---
SERIAL_PORT = "/dev/serial0"
BAUDRATE = 115200
TIMEOUT = 1

# --- Konfigurasi Kompresi ---
MAX_SAMPLES = 37500  # 5 menit * 125 Hz = 37500 sampel
COMPRESSION_LEVEL = 3
Q_BITS = 6
WAVELET = 'haar'

# --- Bandpass Filter ---
def bandpass_filter(data, lowcut=0.5, highcut=40.0, fs=125.0, order=4):
    nyq = 0.5 * fs
    b, a = butter(order, [lowcut/nyq, highcut/nyq], btype='band')
    return filtfilt(b, a, data)

# --- Kompresi DWT + Quant + zlib ---
def compress_dwt_per_level_zlib(signal, level=COMPRESSION_LEVEL, q_bits=Q_BITS):
    coeffs = pywt.wavedec(signal, WAVELET, level=level)
    compressed_parts = []
    metadata = {'lengths': [], 'min_vals': [], 'q_steps': []}

    for coeff in coeffs:
        min_val = np.min(coeff)
        max_val = np.max(coeff)
        q_step = (max_val - min_val) / (2 ** q_bits) if max_val != min_val else 1.0
        quantized = np.round((coeff - min_val) / q_step).astype(np.uint8)
        compressed = zlib.compress(quantized.tobytes())
        
        compressed_parts.append(compressed)
        metadata['lengths'].append(len(quantized))
        metadata['min_vals'].append(float(min_val))
        metadata['q_steps'].append(float(q_step))

    return compressed_parts, metadata

# --- Loop Utama ---
def main():
    # Inisialisasi serial
    ser = serial.Serial(SERIAL_PORT, BAUDRATE, timeout=TIMEOUT)
    print("[Pi0] Inisialisasi sistem...")
    
    # State variables
    recording = False
    sample_rate = 125
    ecg_samples = []
    session_start = None
    
    try:
        while True:
            line = ser.readline().decode(errors='ignore').strip()
            
            if not line:
                continue
                
            # Handle permintaan READY dari ESP32
            if line == "REQUEST_READY":
                print("[Pi0] Menerima permintaan READY dari ESP32")
                ser.write(b"READY\n")
                ser.flush()
                print("[Pi0] Mengirim konfirmasi READY")
                
            # Tangani perintah [START] dari ESP32
            elif line == "[START]":
                # Dapatkan sample rate dari baris berikutnya
                sr_line = ser.readline().decode().strip()
                try:
                    sample_rate = int(sr_line)
                except:
                    sample_rate = 125  # Fallback
                    
                ecg_samples = []
                recording = True
                session_start = time.time()
                print(f"[Pi0] Mulai rekaman @ {sample_rate} Hz")
                print(f"[Pi0] Perkiraan durasi: 5 menit")
                
            # Tangani perintah [END] dari ESP32
            elif line == "[END]":
                if not recording:
                    print("[WARN] Menerima [END] tanpa sesi aktif")
                    continue
                    
                recording = False
                duration = time.time() - session_start
                print(f"[Pi0] Akhir rekaman. Durasi: {duration:.1f} detik")
                print(f"[Pi0] Sampel terkumpul: {len(ecg_samples)}")
                
                # Proses dan kompresi data
                if len(ecg_samples) > 0:
                    process_and_compress(ecg_samples, sample_rate)
                else:
                    print("[WARN] Tidak ada sampel yang terkumpul")
                
                # Reset untuk sesi berikutnya
                ecg_samples = []
                
            # Tangani data sampel ECG
            elif recording:
                try:
                    sample = int(line)
                    ecg_samples.append(sample)
                    
                    # Log kemajuan setiap 5 detik
                    if len(ecg_samples) % (5 * sample_rate) == 0:
                        elapsed = time.time() - session_start
                        print(f"[Pi0] Progress: {len(ecg_samples)} sampel ({elapsed:.1f}s)")
                        
                except ValueError:
                    print(f"[WARN] Data tidak valid: {line}")
                    continue
                
    except KeyboardInterrupt:
        print("\n[Pi0] Dihentikan oleh pengguna")
    finally:
        ser.close()

def process_and_compress(samples, sample_rate):
    start_time = time.time()
    
    # Konversi ke numpy array dan filter
    ecg_array = np.array(samples, dtype=np.float32)
    filtered = bandpass_filter(ecg_array, fs=sample_rate)
    
    print("[Pi0] Memulai kompresi data...")
    
    try:
        # Kompresi menggunakan DWT
        compressed_parts, metadata = compress_dwt_per_level_zlib(filtered)
        compressed = b''.join(compressed_parts)
        
        # Format metadata untuk pengiriman
        meta_list = []
 ```python
        for i in range(len(compressed_parts)):
            meta_list.append({
                "compressed_size": len(compressed_parts[i]),
                "length": metadata['lengths'][i],
                "min_val": metadata['min_vals'][i],
                "q_step": metadata['q_steps'][i]
            })
        
        # Gabungkan data kompresi dan metadata
        marker = b'###META###'
        meta_json = json.dumps(meta_list).encode()
        full_payload = compressed + marker + meta_json
        
        # Statistik kompresi
        original_size = len(filtered) * 4  # float32 = 4 bytes
        compressed_size = len(full_payload)
        ratio = original_size / compressed_size if compressed_size > 0 else 0
        duration = time.time() - start_time
        
        print("\n=== STATISTIK KOMPRESI ===")
        print(f"Jumlah Sampel     : {len(filtered)}")
        print(f"Original Size     : {original_size} bytes")
        print(f"Compressed Size   : {compressed_size} bytes")
        print(f"Compression Ratio : {ratio:.2f}x")
        print(f"Durasi Kompresi   : {duration:.3} detik")
        
        # Kirim ke ESP32
        send_to_esp(full_payload)
        
    except Exception as e:
        print(f"[ERROR] Gagal memproses data: {str(e)}")

def send_to_esp(data):
    try:
        hex_str = binascii.hexlify(data).decode('utf-8').upper()
        message = f"[COMPRESSED];hex={hex_str}\n"
        ser.write(message.encode())
        ser.flush()
        print(f"[Pi0] Data terkompresi dikirim ({len(data)} bytes)")
    except Exception as e:
        print(f"[ERROR] Gagal mengirim data ke ESP32: {str(e)}")

if __name__ == "__main__":
    main()
